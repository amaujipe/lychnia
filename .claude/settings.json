{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/session_start.py\"",
            "timeout": 15,
            "statusMessage": "Injecting docs/ROADMAP.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/pre_commit_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking ROADMAP before commit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/stop_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking the session closing ritual"
          }
        ]
      }
    ]
  }
}
